{
  "name": "bellhop-marketplace-import",
  "version": "0.1.0",
  "description": "Chrome/Edge MV3 extension that imports Idira (CyberArk) Marketplace integrations (Privilege Cloud connection components and platforms) directly into a tenant's Privilege Cloud, skipping the manual download-then-upload round trip.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaearon/bellhop-marketplace-import.git"
  },
  "author": "Tim Schindler",
  "keywords": [
    "cyberark",
    "idira",
    "privilege-cloud",
    "chrome-extension",
    "manifest-v3",
    "psm",
    "connection-components",
    "marketplace"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:version": "node tools/check-version.mjs",
    "check:tag": "node tools/check-tag.mjs",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
