{
  "manifest_version": 3,
  "name": "Idira Marketplace Importer",
  "version": "0.1.0",
  "description": "Import a marketplace connection component or platform into the current Idira tenant.",
  "permissions": [
    "cookies"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.cyberark.cloud/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://*.cyberark.cloud/*",
    "https://jenkinsmarketplacemaster-prod-content-eu-west-2.s3.eu-west-2.amazonaws.com/*"
  ]
}
