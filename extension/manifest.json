{
  "manifest_version": 3,
  "name": "Idira Integration Importer",
  "version": "0.1.0",
  "description": "Import integrations from the Idira Marketplace directly into your tenant.",
  "permissions": [
    "cookies"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.cyberark.cloud/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*.cyberark.cloud/*",
    "https://cyberark.cloud/*",
    "https://*.amazonaws.com/*"
  ]
}
