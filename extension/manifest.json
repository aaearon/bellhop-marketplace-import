{
  "manifest_version": 3,
  "name": "Import to tenant",
  "version": "0.1.0",
  "description": "Import a marketplace connection component into the current tenant.",
  "content_scripts": [
    {
      "matches": ["https://*-marketplace.cyberark.cloud/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://*.cyberark.cloud/*",
    "https://jenkinsmarketplacemaster-prod-content-eu-west-2.s3.eu-west-2.amazonaws.com/*"
  ]
}
